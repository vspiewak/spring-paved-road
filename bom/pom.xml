<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <groupId>com.vspiewak</groupId>
   <artifactId>bom</artifactId>
   <version>${service-starter.version}</version>

   <packaging>pom</packaging>

   <properties>
      <spring-boot.version>4.1.0</spring-boot.version>
      <cucumber.version>7.34.7</cucumber.version>
      <archunit.version>1.4.1</archunit.version>
      <service-starter.version>0.0.1-SNAPSHOT</service-starter.version>
      <mongo-starter.version>0.0.1-SNAPSHOT</mongo-starter.version>
      <cucumber-starter.version>0.0.1-SNAPSHOT</cucumber-starter.version>
      <conventions-starter.version>0.0.1-SNAPSHOT</conventions-starter.version>
   </properties>

   <dependencyManagement>
      <dependencies>

         <!-- spring-boot-dependencies is the importable BOM -->
         <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-dependencies</artifactId>
            <version>${spring-boot.version}</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>

         <!-- our own pins start here : cucumber is not managed by spring-boot-dependencies -->
         <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-bom</artifactId>
            <version>${cucumber.version}</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>

         <!-- neither is archunit -->
         <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
         </dependency>

         <!-- and the platform's own starters : services depend on them versionless too -->
         <dependency>
            <groupId>com.vspiewak</groupId>
            <artifactId>service-starter</artifactId>
            <version>${service-starter.version}</version>
         </dependency>
         <dependency>
            <groupId>com.vspiewak</groupId>
            <artifactId>mongo-starter</artifactId>
            <version>${mongo-starter.version}</version>
         </dependency>
         <dependency>
            <groupId>com.vspiewak</groupId>
            <artifactId>cucumber-starter</artifactId>
            <version>${cucumber-starter.version}</version>
         </dependency>
         <dependency>
            <groupId>com.vspiewak</groupId>
            <artifactId>conventions-starter</artifactId>
            <version>${conventions-starter.version}</version>
         </dependency>

      </dependencies>
   </dependencyManagement>

</project>
